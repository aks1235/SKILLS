{
  "comment": "AI 搜索配置示例 - 复制为 config.json 或 ~/.config/ai-search/config.json 后填入真实值",

  "_comment_ai_service": "=== AI 服务配置 ===",
  "api_url": "http://localhost:8080/v1",
  "api_key": "your-api-key-here",
  "search_model_id": "grok-multi-agent",

  "_comment_analysis": "=== Analysis 服务配置 (拆分查询 + 结果整合,可选,缺省用主服务) ===",
  "analysis_api_url": "",
  "analysis_api_key": "",
  "analysis_model_id": "",
  "analysis_timeout": 90,
  "analysis_retry_count": 1,

  "_comment_prompts": "=== 自定义 Prompt (可选) ===",
  "system_prompt": "",
  "split_prompt": "",
  "synthesize_prompt": "",

  "_comment_behavior": "=== 行为配置 ===",
  "timeout": 60,
  "stream": true,
  "filter_thinking": true,
  "search_retry_count": 1,
  "max_query_length": 10000,
  "default_provider": "ai",

  "_comment_tavily": "=== Tavily 配置 ===",
  "tavily_api_url": "https://tavily.ivanli.cc/api/tavily",
  "tavily_api_key": "your-tavily-key-here",
  "tavily_search_depth": "advanced",
  "tavily_max_results": 8,
  "tavily_include_answer": true,
  "tavily_timeout": 90,
  "tavily_concurrency": 2,

  "_comment_exa": "=== Exa 配置 ===",
  "exa_api_url": "https://api.exa.ai",
  "exa_api_key": "your-exa-key-here",
  "exa_search_type": "auto",
  "exa_num_results": 8,
  "exa_text_max_chars": 1500
}
